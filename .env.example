# Copiar a .env (raíz del repo) y completar. Nunca commitear .env.

# --- Aplicación ---
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
# DATABASE_URL=sqlite:///./backend/data/vcf.db      # por defecto backend/data/vcf.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/vcf   # futuro
# STORAGE_DIR=./backend/storage

# --- Anthropic Claude (análisis y guiones) ---
ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Precios USD por millón de tokens usados para estimar costos
ANTHROPIC_INPUT_USD_PER_MTOK=4.0
ANTHROPIC_OUTPUT_USD_PER_MTOK=20.0

# --- YouTube Data API v3 (radar) ---
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=
# La clave se envía en el header X-Goog-Api-Key (nunca en la URL).
# YOUTUBE_API_BASE sólo se cambia para pruebas contra el servidor falso local.

# --- Transcripción local con Whisper ---
WHISPER_ENABLED=true
WHISPER_MODEL=base        # tiny | base | small | medium (más grande = más lento y preciso)

# --- Voz en off ---
TTS_PROVIDER=espeak       # espeak | none

# --- Límites de uso ---
LIMIT_CLAUDE_CALLS_PER_DAY=50
LIMIT_YOUTUBE_UNITS_PER_DAY=8000
LIMIT_MONTHLY_BUDGET_USD=20
LIMIT_UPLOAD_MB=500
LIMIT_RENDERS_PER_DAY=30

# --- Frontend (servidor Next, NO público) ---
BACKEND_URL=http://127.0.0.1:8000
